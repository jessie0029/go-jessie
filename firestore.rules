rules_version = '2';
// Only you can read or write your data. Replace the email below with the one you sign in with.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == "REPLACE_WITH_YOUR_EMAIL";
    }
  }
}
